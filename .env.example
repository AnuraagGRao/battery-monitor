# VoltWatch Configuration
PORT=3000
NODE_ENV=development

# JWT Session Encryption Key (Change in production)
JWT_SECRET=super_secret_voltwatch_jwt_key_2026_change_in_production

# Global webhook secret
WEBHOOK_SECRET=vw_sec_YOUR_WEBHOOK_SECRET
ADMIN_EMAIL=anuraag7rao@gmail.com

# ── Firebase Authentication (Recommended for Google Sign-In) ────────────────
# 1. Open https://console.firebase.google.com
# 2. Enable Authentication -> Sign-in method -> Google
# 3. In Project Settings -> General -> Web Apps, copy your config values:
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# ── Alternative: Direct Google OAuth 2.0 Credentials ─────────────────────────
# From Google Cloud Console (https://console.cloud.google.com/apis/credentials):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
